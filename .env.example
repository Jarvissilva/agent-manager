# Optional. Trusted HTTPS origin for a private reverse proxy such as Tailscale
# Serve. Leave empty for localhost-only browser access. Restart the server after
# changing it. This is an origin allowlist, not authentication.
AGENT_MANAGER_PUBLIC_ORIGIN=

# Optional. Port the Express server listens on (default 3001).
# PORT=3001

# Optional. SQLite database location (default server/data/agent-manager.sqlite).
# AGENT_MANAGER_DB_PATH=/absolute/path/to/agent-manager.sqlite

# Optional. Home directory used for native skill discovery (default: your home).
# AGENT_MANAGER_SKILL_HOME=/home/you

# Optional. Home directory used for native MCP discovery (default: your home).
# AGENT_MANAGER_MCP_HOME=/home/you
