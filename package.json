{
  "name": "agentos",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:client": "pnpm --filter @agentos/client dev",
    "dev:server": "pnpm --filter @agentos/server dev",
    "build": "pnpm -r build",
    "prod:start": "pnpm build && pm2 startOrRestart ecosystem.config.cjs --only agentos",
    "prod:restart": "pm2 restart ecosystem.config.cjs --only agentos",
    "prod:stop": "pm2 stop agentos",
    "prod:logs": "pm2 logs agentos",
    "prod:status": "pm2 show agentos",
    "prod:migrate-paths": "node --env-file-if-exists=.env migrate-repository.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  }
}
